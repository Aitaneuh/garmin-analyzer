# Copy to .env for local dev (npm run dev), or set these as env vars in Portainer.
STRAVA_CLIENT_ID=12345
STRAVA_CLIENT_SECRET=your_client_secret
APP_URL=http://192.168.1.50:3000
DASHBOARD_PASSWORD=change-me
SYNC_INTERVAL_MINUTES=60

# Names used directly by Nuxt (for `npm run dev`):
NUXT_STRAVA_CLIENT_ID=12345
NUXT_STRAVA_CLIENT_SECRET=your_client_secret
NUXT_APP_URL=http://localhost:3000
NUXT_DASHBOARD_PASSWORD=
